	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<parameterDescription><![CDATA[]]></parameterDescription>
		<defaultValueExpression><![CDATA["./"]]></defaultValueExpression>
	</parameter>
	<parameter name="RECORD_ID" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[null /*new BigDecimal(1007667)*/]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[-- Kundenkonditionen
-- (Query ist geeignet für JasperReports)
select distinct on (c.c_bpartner_id, cs.value, c.m_product_id, c.datefrom > now())
bp.value as bp_value,
bp.name as bp_name,
bp.name2 as bp_name2,
p.value as p_value,
p.name as p_name,
uom.uomsymbol,
c.description,
c.datefrom::date,
c.amount,
c.percent,
cs.name || case when condtype = 'S' then ' Preis wie' when condtype = 'A' then ' Erhöhung' else '' end as rubrik,
(max(c.datefrom) over (partition by c.c_bpartner_id))::date as date_max
FROM bay_condition c
join c_bpartner bp on bp.c_bpartner_id = c.c_bpartner_id
left join m_product p on p.m_product_id = c.m_product_id
join bay_conditionstage cs on cs.bay_conditionstage_id = c.bay_conditionstage_id
left join c_uom uom on uom.c_uom_id = c.c_uom_id
where bp.c_bpartner_id = $P{RECORD_ID} 
--where bp.value = '11113'
and cs.value in ('55', '70')
order by c.c_bpartner_id, cs.value, c.m_product_id, c.datefrom > now() desc, c.datefrom desc
;
]]>
	</queryString>
