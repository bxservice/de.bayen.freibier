	<template><![CDATA[$P{SUBREPORT_DIR}+"BayenStyles.jrtx"]]></template>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<parameterDescription><![CDATA[]]></parameterDescription>
		<defaultValueExpression><![CDATA["./"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select r.value, r.name
from s_resource r
join s_resourcetype rt on (rt.s_resourcetype_id = r.s_resourcetype_id)
left join s_resourceunavailable ru on (ru.s_resource_id = r.s_resource_id and ru.datefrom <= now()::date and ru.dateto >= now()::date ) 
where r.ad_client_id = 1000000 and r.isactive = 'Y'
and rt.value = 'Fahrer'
and not exists(select ru.s_resourceunavailable_id from s_resourceunavailable ru where ru.s_resource_id = r.s_resource_id and ru.datefrom <= now()::date and ru.dateto >= now()::date)
order by r.name]]>
	</queryString>
