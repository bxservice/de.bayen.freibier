	<parameter name="MONAT" class="java.sql.Date">
		<parameterDescription><![CDATA[Datum des ausgewerteten Monats]]></parameterDescription>
		<defaultValueExpression><![CDATA[new Date()]]></defaultValueExpression>
	</parameter>
	<queryString language="SQL">
		<![CDATA[with
myvalues as(
  select 
    $P{MONAT}::date as currentday,
    --current_date + interval '20 days'  as currentday,
    time '07:15' as workstart
),
--
morevalues  as(
select
  date '2000-01-01'
    + interval '1 year' * (date_part('year', currentday)-2000)
    + interval '1 month' * (date_part('month', currentday)-1) as firstday,
  date '2000-01-01'
    + interval '1 year' * (date_part('year', currentday)-2000)
    + interval '1 month' * (date_part('month', currentday)) - interval '1 day' as lastday
from myvalues
),
--
alldays_series as(
select
  date (generate_series( firstday, lastday, interval '1 day')) as dom,
  myvalues.*
from morevalues cross join myvalues
),
alldays as (
select
  alldays_series.*,
  to_char(currentday,'TMMonth') || ' ' ||  to_char(currentday,'YYYY') as monat,
  dom as workday,
  date_part('dow', dom) as dow, -- 0=Sonntag
  to_char(dom, 'TMDy') as dowtext,
  date_part('dow', dom) in (0,6) as holiday
from alldays_series
)
--
select * from employee
cross join alldays
--where value >= 'M6'
where rt_name = 'Fahrer' --value >= 'M6'
order by name, value, dom
;]]>
	</queryString>
