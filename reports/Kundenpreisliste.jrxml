		<property name="com.jaspersoft.studio.field.tree.path" value="bay_company_v"/>
	</field>
	<field name="me_postal" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="me_postal"/>
		<property name="com.jaspersoft.studio.field.label" value="me_postal"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="bay_company_v"/>
	</field>
	<field name="me_city" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="me_city"/>
		<property name="com.jaspersoft.studio.field.label" value="me_city"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="bay_company_v"/>
	</field>
