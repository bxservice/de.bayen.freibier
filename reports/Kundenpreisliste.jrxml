		<property name="com.jaspersoft.studio.field.name" value="s_city"/>
		<property name="com.jaspersoft.studio.field.label" value="s_city"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="c_location"/>
	</field>
	<field name="pl_name" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="pl_name"/>
		<property name="com.jaspersoft.studio.field.label" value="pl_name"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="m_pricelist"/>
	</field>
	<field name="pl_description" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="pl_description"/>
		<property name="com.jaspersoft.studio.field.label" value="pl_description"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="m_pricelist"/>
	</field>
	<field name="org_name" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="org_name"/>
		<property name="com.jaspersoft.studio.field.label" value="org_name"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="bay_company_v"/>
	</field>
	<field name="me_address1" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="me_address1"/>
