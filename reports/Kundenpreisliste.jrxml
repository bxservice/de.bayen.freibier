	<queryString>
		<![CDATA[-- Preisliste für Kunden

/* Ich möchte einen JasperReport erzeugen, der Preislisten schön druckt. 
 *
 * Dann möchte ich es ermöglichen, die zu Grunde liegenden Preise auf verschiedene Arten zu berechnen.
 * Ein zusammenfassender Query soll die dann in eine Struktur bringen, die im Report genutzt werden
 * kann.
 * 
 * Der Report braucht Standard-Daten je Kunde. Er erlaubt mehrere Spalten, die dann durch Parameter
 * ausgewählt werden können.
 * 
 */

-- Parameter
WITH param AS (
select
$P{C_BPartner_ID} as c_bpartner_id,
$P{*RecordIDs*} as recordids,
$P{DateFrom}::date as datefrom,
$P{DateTo}::date as dateto,
$P{FilterBezug}::varchar as filterbezug,
$P{FilterPreisartikel}::varchar as filterpreisartikel,
$P{FilterSortiment}::varchar as filtersortiment,
$P{FilterSonderpreis}::varchar as filtersonderpreis,
$P{PrintSameAs} as printsameas,
$P{PrintIntern} as printintern
--
--(SELECT c_bpartner_id FROM c_bpartner WHERE value = '12251' ) as c_bpartner_id,
--(SELECT c_bpartner_id FROM c_bpartner WHERE value = '22010') as c_bpartner_id,
--null::date as datefrom,
--null::date as dateto,
--'N' as filterbezug,
----'Y' as filterpreisartikel,
--'N' as filterpreisartikel,
--'N' as filtersortiment,
--'N' as filtersonderpreis
--'Y' as printsameas,
--'Y' as printintern
)
,
-- Auswahl der Geschäftspartner
bp AS (
select
distinct on (bp.c_bpartner_id, li.c_location_id)
bp.value AS bp_value,
bp.name AS bp_name,
bp.name2 AS bp_name2,
--
ad.value as ad_value,
ad.name as ad_name,
ad.phone as ad_phone,
--
li.address1 as i_address1,
li.address2 as i_address2,
li.postal as i_postal,
li.city as i_city,
ls.address1 as s_address1,
ls.address2 as s_address2,
ls.postal as s_postal,
ls.city as s_city,
--
pl.name as pl_name,
pl.description as pl_description,
--
org_name,
me.address1 as me_address1,
me.postal as me_postal,
me.city as me_city,
me.phone as me_phone,
me.receiptfootermsg,
me.bank_name,
--
bp.c_bpartner_id
FROM c_bpartner bp
cross join param
cross join bay_company_v me
join ad_user ad on ad.ad_user_id = bp.salesrep_id
join c_bpartner_location bpls on bpls.c_bpartner_id = bp.c_bpartner_id and bpls.isactive = 'Y' and bpls.isshipto = 'Y'
join c_location ls on ls.c_location_id = bpls.c_location_id
join c_bpartner_location bpli on bpli.c_bpartner_id = bp.c_bpartner_id and bpli.isactive = 'Y' and bpli.isbillto = 'Y'
join c_location li on li.c_location_id = bpli.c_location_id
join m_pricelist pl on pl.m_pricelist_id = bp.m_pricelist_id
WHERE bp.ad_client_id = me.ad_client_id AND bp.isactive = 'Y' AND bp.iscustomer = 'Y'
--and param.c_bpartner_id is null or param.c_bpartner_id = bp.c_bpartner_id
and (param.c_bpartner_id = bp.c_bpartner_id
     or bp.C_BPartner_ID IN (SELECT jsonb_array_elements_text(param.recordids::jsonb)::int)
    )
)
--select * from bp;
,
-- Preis Wie Artikel
pwa AS (
-- Diese Abfrage beachtet weder Artikelklassen noch erlaubt sie das zeitgesteuerte Deaktivieren von einzelnen PWAs
-- (und dadurch eigentlich gar keine Zeitsteuerung, weil alle denkbarern Geschäftsvorfälle so keinen Sinn ergeben)
select
distinct on (c.m_product_id)
c.m_product_id, c.bay_sameasproduct_id
FROM bay_c_document d
JOIN bay_c_doctype dt ON d.bay_c_doctype_id = dt.bay_c_doctype_id
JOIN bay_c_condition c ON c.bay_c_document_id = d.bay_c_document_id and c.isactive = 'Y'
JOIN bay_c_conditioncase cc ON cc.bay_c_conditioncase_id = c.bay_c_conditioncase_id
WHERE d.ad_client_id = 1000000 AND d.isactive = 'Y' 
AND dt.value = 'PWART' AND cc.value = 'PWA'
ORDER BY c.m_product_id, d.datetrx desc
)
,
-- Artikelliste aller Artikel
p AS (
SELECT
p.value AS p_value,
p.name AS p_name,
p.discontinued,
p.isactive,
--
pc.value as pc_value,
pc.name as pc_name,
--
uom.uomsymbol as uom_symbol,
uom.name as uom_name,
uompl.uomsymbol as uompl_symbol,
uompl.name as uompl_name,
uf.factor,
--
case when pc.value not in ('17','18','22','77','99') then 'Y' else 'N' end as isleistung,
case when p.m_product_id in (select pwa.bay_sameasproduct_id from pwa) then 'Y' else 'N' end as isbaseproduct,
(select pwa.bay_sameasproduct_id from pwa where pwa.m_product_id = p.m_product_id) as bay_sameasproduct_id,
(select 
  string_agg(case when psa.bay_tradingunit_id is null then psa.name else psa.description end,'/' order by psa.value) as sa_list
  from (select * from pwa where p.m_product_id = pwa.bay_sameasproduct_id) l
  join m_product psa on psa.m_product_id = l.m_product_id
  group by l.bay_sameasproduct_id
  order by l.bay_sameasproduct_id
) as sameas_liste,
--
p.m_product_id,
uom.c_uom_id,
pc.m_product_category_id
FROM m_product  p
join m_product_category pc on pc.m_product_category_id = p.m_product_category_id
join c_uom uom on uom.c_uom_id = p.c_uom_id
join c_uom uompl on uompl.c_uom_id = coalesce(pc.c_uom_id, p.c_uom_id)
join bay_uomfactor_v uf on uf.m_product_id = p.m_product_id and uf.c_uom_id = uompl.c_uom_id
WHERE p.ad_client_id = 1000000
)
,
-- Bezogene Artikel des Kunden in den vergangenen 14 Monaten
bezug as (
select
distinct on (bp.c_bpartner_id, ol.m_product_id)
bp.c_bpartner_id,
ol.m_product_id
from bp
cross join param
join c_order o on o.c_bpartner_id = bp.c_bpartner_id
join c_orderline ol on ol.c_order_id = o.c_order_id
join c_doctype dt on o.c_doctypetarget_id = dt.c_doctype_id
join p on p.m_product_id = ol.m_product_id  -- hier wird z.B. Pfand ausgefiltert
where o.docstatus in ('CO', 'IP') and dt.docsubtypeso = 'WI' /* Kreditauftrag */
and o.dateordered between coalesce(param.datefrom, now() - '14 months'::interval) and coalesce(param.dateto, '2099-12-31')
and ol.bay_masterorderline_id is null
order by bp.c_bpartner_id, ol.m_product_id
)
--select * from bezug join p using (m_product_id)
,
-- eingegebenes Kundensortiment
kundensortimentconfig as (
select distinct on (bp.c_bpartner_id, l.m_product_id)
  bp.c_bpartner_id,
  l.m_product_id,
  l.line,
  l.qtyentered,
  l.description
from c_orderline l
join c_order o on l.c_order_id = o.c_order_id
join bp on o.c_bpartner_id = bp.c_bpartner_id
join c_doctype dt on (o.c_doctypetarget_id=dt.c_doctype_id)
--join c_bpartner bp on (o.c_bpartner_id=bp.c_bpartner_id)
where o.docstatus = 'DR' and dt.docsubtypeso ='ON' /* unverbindliches Angebot */
  and l.bay_masterorderline_id is null
order by bp.c_bpartner_id, l.m_product_id, o.documentno desc, l.line desc
)
,
-- Knodensortiment inklusive des Bezugs der letzten 14 Monate (wie im QuickInfo)
kundensortiment as (
select
  coalesce(be.c_bpartner_id, ks.c_bpartner_id) as c_bpartner_id,
  p.m_product_id,
  ks.line,
  case when ks.line is null then 'N' else 'Y' end as issortiment
from bezug be
full outer join kundensortimentconfig ks on ks.m_product_id = be.m_product_id and ks.c_bpartner_id = be.c_bpartner_id  -- TODO das "full outer join" geht so nicht mit mehreren BPartnern :-(
join p on p.m_product_id = coalesce(be.m_product_id, ks.m_product_id) and p.isactive = 'Y'
where ks.qtyentered is distinct from 0
)
,
-- Basisartikel zum Bezug
bezugbasisartikel as(
select
distinct bezug.c_bpartner_id, p.m_product_id
from bezug
left join pwa on pwa.m_product_id = bezug.m_product_id
join p on p.m_product_id = coalesce (pwa.bay_sameasproduct_id, bezug.m_product_id)
)
,
preiskonditionen as (
select
pk.c_bpartner_id, pk.m_product_id
from (
	select
	distinct on (bp.c_bpartner_id, c.m_product_id)
	bp.c_bpartner_id, c.m_product_id, c.amount
	from bay_condition c
	cross join param
	join bp on bp.c_bpartner_id = c.c_bpartner_id
	join bay_conditionstage cs on cs.bay_conditionstage_id = c.bay_conditionstage_id
	where cs.value = '55' and c.condtype = 'F'
	and c.datefrom between coalesce(param.datefrom, '1970-01-01') and coalesce(param.dateto, '2099-12-31')
	order by bp.c_bpartner_id, c.m_product_id, c.datefrom desc
) pk
where pk.amount is not null
)
--select * from preiskonditionen;
,
-- Zusammenfasssung mehrerer möglicher Listen in einer mehrspaltigen Liste
uebersicht as (
select
bp.c_bpartner_id, 
p.m_product_id,
case when bezug.c_bpartner_id is null then 'N' else 'Y' end as isbezug,
case when pa.c_bpartner_id is null then 'N' else 'Y' end as ispreisartikel,
case when ks.c_bpartner_id is null then 'N' else 'Y' end as issortiment,
case when kon.c_bpartner_id is null then 'N' else 'Y' end as issonderpreis
from bp
join p on p.isactive = 'Y' and p.isleistung = 'Y'
left join bezug bezug on bezug.c_bpartner_id = bp.c_bpartner_id and bezug.m_product_id = p.m_product_id           -- Bezug
left join bezugbasisartikel pa on pa.c_bpartner_id = bp.c_bpartner_id and pa.m_product_id = p.m_product_id        -- Preisartikel
left join kundensortiment ks on ks.c_bpartner_id = bp.c_bpartner_id and ks.m_product_id = p.m_product_id          -- angelegtes Sortiment
left join preiskonditionen kon on kon.c_bpartner_id = bp.c_bpartner_id and kon.m_product_id = p.m_product_id      -- angelegte Sonderpreise
-- todo: eingegebene Sonderpreise
where bezug.c_bpartner_id is not null or pa.c_bpartner_id is not null or ks.c_bpartner_id is not null or kon.c_bpartner_id is not null
)
--select * from uebersicht;
,
-- Nur die Artikel mit direkten Preisen heraussuchen
preisartikeluebersicht as (
select
u.c_bpartner_id, u.m_product_id,
case when every(isbezug = 'N') then 'N' else 'Y' end as isbezug,
'Y' as ispreisartikel,
case when every(issortiment = 'N') then 'N' else 'Y' end as issortiment,
case when every(issonderpreis = 'N') then 'N' else 'Y' end as issonderpreis
from uebersicht u
left join pwa on pwa.m_product_id = u.m_product_id
join p on p.m_product_id = coalesce (pwa.bay_sameasproduct_id, u.m_product_id)
group by u.c_bpartner_id, u.m_product_id
)
--select * from preisartikeluebersicht;
,
-- Übersicht mit zusätzlichen Zeilen für Basispreise
uebersichtmitbasispreisen as (
select
--distinct on (u.c_bpartner_id, u.m_product_id)
u.c_bpartner_id, u.m_product_id,
max(isbezug) as isbezug,                -- Der Basisartikel gilt auch als bezogen. Ich denke, sonst kann man schlecht Preislisten über bezogene Artikel machen
max(ispreisartikel) as ispreisartikel,
min(issortiment) as issortiment,        -- Der Basisartikel ist nicht automatisch im Sortiment. Das würde dem Sinn des Sortiments zuwiderlaufen
max(issonderpreis) as issonderpreis     -- Der abgeleitete Artikel gilt automatisch auch als mit Sonderpreis, wenn der Basisartikel einen hat. Dieser ist ja vom Basisartikel abgeleitet.
from (
  select 1 as sorter, * from uebersicht
  union
  select 2 as sorter, * from preisartikeluebersicht
) as u
group by u.c_bpartner_id, u.m_product_id
--order by u.c_bpartner_id, u.m_product_id, sorter
)
--select * from uebersichtmitbasispreisen;
,
-- Liste für Ausdruck
output as (
select
bp.*, 
p.*,
round(c.amount,2) as amount,
round(c.amount/p.factor,2) as amountpl,
c.datefrom,
now() as now,
coalesce(param.dateto::date, max(c.datefrom) over (partition by bp.c_bpartner_id)) as dateto,
u.isbezug,
u.ispreisartikel,
u.issortiment,
u.issonderpreis,
param.filterbezug,
param.filterpreisartikel,
param.filtersortiment,
param.filtersonderpreis,
param.printsameas,
param.printintern
from uebersichtmitbasispreisen u
cross join param
join bp on bp.c_bpartner_id = u.c_bpartner_id
join p on p.m_product_id = u.m_product_id
cross join bay_conditionprice(p.m_product_id, null, bp.c_bpartner_id, coalesce(param.dateto::timestamp, '2099-12-31'::timestamp), '50', '55') as c
where 
(param.filterbezug = 'N' or u.isbezug = 'Y')
and (param.filterpreisartikel = 'N' or u.ispreisartikel = 'Y')
and (param.filtersortiment = 'N' or u.issortiment = 'Y')
and (param.filtersonderpreis = 'N' or u.issonderpreis = 'Y')
)
select * from output order by bp_value, pc_value, p_value
--select * from kundensortiment ks join p on ks.m_product_id = p.m_product_id
--select * from p

]]>
	</queryString>
	<field name="bp_value" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="bp_value"/>
		<property name="com.jaspersoft.studio.field.label" value="bp_value"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="c_bpartner"/>
	</field>
	<field name="bp_name" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="bp_name"/>
		<property name="com.jaspersoft.studio.field.label" value="bp_name"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="c_bpartner"/>
	</field>
	<field name="bp_name2" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="bp_name2"/>
		<property name="com.jaspersoft.studio.field.label" value="bp_name2"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="c_bpartner"/>
	</field>
	<field name="ad_value" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="ad_value"/>
		<property name="com.jaspersoft.studio.field.label" value="ad_value"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="ad_user"/>
	</field>
	<field name="ad_name" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="ad_name"/>
		<property name="com.jaspersoft.studio.field.label" value="ad_name"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="ad_user"/>
	</field>
	<field name="ad_phone" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="ad_phone"/>
		<property name="com.jaspersoft.studio.field.label" value="ad_phone"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="ad_user"/>
	</field>
	<field name="i_address1" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="i_address1"/>
		<property name="com.jaspersoft.studio.field.label" value="i_address1"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="c_location"/>
	</field>
	<field name="i_address2" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="i_address2"/>
		<property name="com.jaspersoft.studio.field.label" value="i_address2"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="c_location"/>
	</field>
	<field name="i_postal" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="i_postal"/>
		<property name="com.jaspersoft.studio.field.label" value="i_postal"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="c_location"/>
	</field>
	<field name="i_city" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="i_city"/>
		<property name="com.jaspersoft.studio.field.label" value="i_city"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="c_location"/>
	</field>
	<field name="s_address1" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="s_address1"/>
		<property name="com.jaspersoft.studio.field.label" value="s_address1"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="c_location"/>
	</field>
	<field name="s_address2" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="s_address2"/>
		<property name="com.jaspersoft.studio.field.label" value="s_address2"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="c_location"/>
	</field>
	<field name="s_postal" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="s_postal"/>
		<property name="com.jaspersoft.studio.field.label" value="s_postal"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="c_location"/>
	</field>
