	<parameter name="*RecordIDs*" class="java.lang.String"/>
	<parameter name="RECORD_ID" class="java.lang.Integer">
		<parameterDescription><![CDATA[z.B. für schwarzes Pferd: 1010289]]></parameterDescription>
	</parameter>
	<parameter name="AD_PINSTANCE_ID" class="java.lang.Integer"/>
	<parameter name="reportvariant" class="java.lang.String"/>
	<queryString>
		<![CDATA[select
bp.c_bpartner_id, $P{*RecordIDs*} as records
FROM C_BPartner bp
--where bp.C_BPartner_ID = $ P{RECORD_ID}
--where $ X{IN, bp.C_BPartner_ID, *RecordIDs*}
where bp.C_BPartner_ID IN (SELECT jsonb_array_elements_text($P{*RecordIDs*}::jsonb)::int) 
   OR bp.C_BPartner_ID = $P{RECORD_ID}
--where bp.C_BPartner_ID in (1010289,1009241,1009542,1000780,1007587, 1008401)
--union select null
union select null, $P{*RecordIDs*} where (($P{RECORD_ID}>0) is distinct from true) and $P{*RecordIDs*} IS NULL
]]>
	</queryString>
