	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<parameterDescription><![CDATA[]]></parameterDescription>
		<defaultValueExpression><![CDATA["./"]]></defaultValueExpression>
	</parameter>
	<parameter name="RECORD_ID" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[null /*new BigDecimal(1007667)*/]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[-- Besuchsberichte
-- (Query ist geeignet für JasperReports)
SELECT
starttime,
extract (minutes from endtime - starttime) AS dauer,
bp.value AS bp_value, 
bp.name AS bp_name,
bp.name2 AS bp_name2,
st.name as status,
rs.name as kontaktort,
r.summary
FROM R_Request r
LEFT JOIN c_bpartner bp ON r.c_bpartner_id = bp.c_bpartner_id
LEFT JOIN r_status st ON st.r_status_id = r.r_status_id
left join r_resolution rs on rs.r_resolution_id = r.r_resolution_id
where r.ad_client_id = 1000000
and bp.c_bpartner_id = $P{RECORD_ID} 
--and bp.value = '13041'
order by starttime desc]]>
	</queryString>
