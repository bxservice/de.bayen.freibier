	<parameter name="AD_PINSTANCE_ID" class="java.lang.Integer" isForPrompting="false"/>
	<queryString>
		<![CDATA[select
*
,
(select count(*) from t_report )::text as test
from ctr.bay_weinsortiment
where m_product_id =  $P{RECORD_ID}
or
m_product_id in 
(
select json_array_elements(p_string::json)::text::int as record 
from ad_pinstance_para where ad_pinstance_id = $P{AD_PINSTANCE_ID}
)
order by ctr.bay_weinsortiment.p_no]]>
	</queryString>
