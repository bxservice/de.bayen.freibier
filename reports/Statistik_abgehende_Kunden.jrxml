	<template><![CDATA[$P{SUBREPORT_DIR}+"BayenStyles.jrtx"]]></template>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<parameterDescription><![CDATA[]]></parameterDescription>
		<defaultValueExpression><![CDATA["./"]]></defaultValueExpression>
	</parameter>
	<parameter name="AD_User_ID" class="java.lang.Integer">
		<parameterDescription><![CDATA[Außendienstler]]></parameterDescription>
	</parameter>
	<queryString language="SQL">
		<![CDATA[with q as (
select
   $P{AD_User_ID}::integer as ad
),
lak as (
select
  c_bpartner_id,
  coalesce(substring(laktext, '^(?:(\d+)/(?:\d+))$')::integer, 300) as umsatzschwelle,
  coalesce(substring(laktext, '^(?:(?:\d+)/(\d+))$')::integer, 2) as wochen,
  case when laktext like 'abgemeldet%' then 'Y' else 'N' end as abgemeldet,
  laktext
from (
  -- ein subselect, um den regex hier nur einmal auszuführen, obwohl ich dessen Ergebnis oben öfters nutze
  select 
    bp.c_bpartner_id,
    bp.value, bp.name,
    substring(coalesce(bp.description, '') || ' ' || coalesce(bpg.description, ''), '(?:^|\n| )LAK: ([^ ]+)') as laktext
  from c_bpartner bp
  left join c_bp_group bpg using (c_bp_group_id)
  where bp.ad_client_id=1000000 and bp.isactive='Y'
) laktext
),
letztermonat as (
select
  o.c_bpartner_id,
  sum (o.totallines) as total,
  max(o.dateordered) as lastdate
from
c_order o
join lak using (c_bpartner_id)
where o.ad_client_id =1000000 and o.issotrx='Y'
  and o.dateordered between now() - interval '1 week' * lak.wochen and now()
group by
  c_bpartner_id
),
letztesjahr as (
select
  o.c_bpartner_id,
  sum (o.totallines) as total,
  max(o.dateordered) as lastdate
from
c_order o
join c_bpartner bp using (c_bpartner_id)
where o.ad_client_id =1000000 and o.issotrx='Y'
  and o.dateordered between now() - interval '1 year' and now()
group by
  c_bpartner_id
)
select
  ad.name as ad_name,
  bpg.name as bpg_name,
  bp.value as bp_value,
  bp.name as bp_name,
  bp.name2 as bp_name2,
  bp.totalopenbalance,
  lj.total,
  lj.lastdate,
  bp.description,
  lak.*
from letztesjahr lj
full outer join letztermonat lm using (c_bpartner_id)
cross join q
join c_bpartner bp using (c_bpartner_id)
join lak using (c_bpartner_id)
left join c_bp_group bpg using (c_bp_group_id)
left join ad_user ad on (ad.ad_user_id = bp.salesrep_id)
where lm.c_bpartner_id is null
  and lj.total > lak.umsatzschwelle
  and lak.abgemeldet = 'N'
  -- and bp.iscustomer='Y'  -- bleiben als Mahnung und Anregung
--  and ad.value='mmarino'
  and (ad.ad_user_id = q.ad or q.ad is null or q.ad = 0)
order by ad.value, bpg.value, bp.value]]>
	</queryString>
