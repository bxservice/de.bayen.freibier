	<template><![CDATA[$P{SUBREPORT_DIR}+"BayenStyles.jrtx"]]></template>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<parameterDescription><![CDATA[]]></parameterDescription>
		<defaultValueExpression><![CDATA["./"]]></defaultValueExpression>
	</parameter>
	<parameter name="DateOrdered" class="java.util.Date" isForPrompting="false"/>
	<queryString>
		<![CDATA[select
o.dateordered::date as datum,
rl2.name as vorladen,
rou.value as tour, res.value as lkw,
rl1.name as ladevorgabe,
bp.value kdnr, bp.name as kd_name, bp.name2 as kd_name2,
weight as gewicht, documentno as lieferschein
FROM c_order o
join c_bpartner bp on bp.c_bpartner_id = o.c_bpartner_id
join c_bpartner_location bpl  on bpl.c_bpartner_location_id = o.c_bpartner_location_id
left join ad_ref_list rl1 on rl1.value = bpl.bay_loadinghint and rl1.ad_reference_id = (select ad_reference_id from ad_reference ref where ref.name='BAY Ladevorgabe')
left join ad_ref_list rl2 on rl2.value = o.prepicking and rl2.ad_reference_id = (select ad_reference_id from ad_reference ref where ref.name='BAY Vorladen')
left join bay_route rou on rou.bay_route_id = o.bay_route_id
left join bay_delivery d on d.bay_route_id = rou.bay_route_id and d.bay_routedate = o.dateordered 
left join s_resource res on res.s_resource_id = d.bay_truck_id
where o.ad_client_id=1000000
and o.docstatus in ('IP')
and o.prepicking is not null
and o.dateordered =  coalesce($P{DateOrdered}, now()::date)
order by o.dateordered, rl2.value, rou.value, bpl.bay_loadinghint, bp.value, o.documentno]]>
	</queryString>
