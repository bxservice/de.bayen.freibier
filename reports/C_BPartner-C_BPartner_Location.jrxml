	<parameter name="RECORD_ID" class="java.lang.Integer"/>
	<queryString>
		<![CDATA[select
c_bpartner_location_id
from (
select bpl.c_bpartner_location_id, bpl.isshipto, bpl.c_salesregion_id, bpl.bay_route_id
from c_bpartner_location bpl 
where bpl.isActive='Y'
and bpl.c_bpartner_id =  $P{RECORD_ID} 
union all select null,null,null,null
union all (select null,null,null,null where ($P{RECORD_ID}>0) is distinct from true)
) as bpl
order by c_bpartner_location_id is null, isshipto desc, c_salesregion_id is null, bay_route_id is null]]>
	</queryString>
