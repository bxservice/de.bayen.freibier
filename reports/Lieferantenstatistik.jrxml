<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Lieferantenstatistik" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" isSummaryNewPage="true" isSummaryWithPageHeaderAndFooter="true" uuid="c9b180ac-67e2-4eb1-b58f-9828c7917dcc">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Adempiere"/>
	<template><![CDATA[$P{SUBREPORT_DIR}+"BayenStyles.jrtx"]]></template>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<parameterDescription><![CDATA[]]></parameterDescription>
		<defaultValueExpression><![CDATA["./"]]></defaultValueExpression>
	</parameter>
	<parameter name="kumuliert" class="java.lang.String">
		<defaultValueExpression><![CDATA["N"]]></defaultValueExpression>
	</parameter>
	<parameter name="Period" class="java.lang.String">
		<defaultValueExpression><![CDATA["gj2019"]]></defaultValueExpression>
	</parameter>
	<parameter name="C_BPartner_ID" class="java.lang.Integer">
		<parameterDescription><![CDATA[]]></parameterDescription>
		<defaultValueExpression><![CDATA[null]]></defaultValueExpression>
	</parameter>
	<parameter name="C_BP_Group_ID" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[1000001]]></defaultValueExpression>
	</parameter>
	<parameter name="Manufacturer_ID" class="java.lang.Integer">
		<parameterDescription><![CDATA[z.B. 1006771 für Bitburger Gruppe]]></parameterDescription>
		<defaultValueExpression><![CDATA[null]]></defaultValueExpression>
	</parameter>
	<queryString language="SQL">
		<![CDATA[with params as (
select
  $P{Period}::text periode1,
  null::text periode2,
  $P{C_BPartner_ID}::numeric c_bpartner_id,
  $P{C_BP_Group_ID}::numeric c_bp_group_id,
  $P{Manufacturer_ID}::numeric manufacturer_id
),
bpartner_filter as (
select bp.c_bpartner_id
from c_bpartner bp
cross join params
where ad_client_id=1000000
  and (bp.c_bpartner_id=params.c_bpartner_id or params.c_bpartner_id is null or params.c_bpartner_id=0)
  and (bp.c_bp_group_id=params.c_bp_group_id or params.c_bp_group_id is null or params.c_bp_group_id=0)
)
,
per as(
select * 
from bay_statperiod_v per
cross join params
where per.value = periode1
),
per2 as(
select * 
from params
left join bay_statperiod_v per on (
  per.value = coalesce(periode2,
  	case when left (periode1,2)='st' 
  	     then 'st' || to_char(substring(periode1 from 3 for 2)::numeric -1,'FM00') || substring(periode1 from 5 for 2)
  	     when left (periode1,2)='gj' 
  	     then 'gj' || to_char(substring(periode1 from 3 for 4)::numeric -1,'FM0000')
  	     else null
  	     end
  ))
),
stat as (
select stat.*
from per
left join bay_umsatzstat_v stat using(bay_statistikperiode_id)
join m_product p using (m_product_id)
join bpartner_filter bp_f on (bp_f.c_bpartner_id=stat.c_bpartner_id)
where p.c_uom_id = stat.c_uom_id  -- nur Zeilen mit der Haupt-UOM zählen
  -- man könnte das auch umrechnen, addieren, und dann kürzen. Das kommt bisher praktisch aber aufs gleiche raus und würde wohl Performance kosten
)
-- Debugging wg. Kosakowski und Knobelbecher mit Würfeln
--select stat.*, c_bpartner.value, c_bpartner.name from stat join c_bpartner using (c_bpartner_id) where m_product_id = (select m_product_id from m_product where m_product.value='90085')
,
stat2 as (
select stat2.* 
from per2
left join bay_umsatzstat_v stat2 using(bay_statistikperiode_id)
join m_product p using (m_product_id)
join bpartner_filter bp_f on (bp_f.c_bpartner_id=stat2.c_bpartner_id)
where p.c_uom_id = stat2.c_uom_id  -- nur Zeilen mit der Haupt-UOM zählen
  -- man könnte das auch umrechnen, addieren, und dann kürzen. Das kommt bisher praktisch aber aufs gleiche raus und würde wohl Performance kosten
)
select
manu.value as manu_value,
manu.name as manu_name,
art.cat_value as akat_nr,
art.cat_name as akat_name,
p.classification,
case 
  when first_value(p.classification) over (partition by manu.value, art.cat_value order by p.classification)
       is not null
  then 'Y' else 'N' end 
  as classification_used,
art.value as art_nr,
art.name_base as art_name,
art.name_tu as art_tu,
art.isactive as art_isactive,
bp.value as kd_nr,
bp.name as kd_name,
bp.name2 as kd_name2,
adm.name as adm,
sum(stat.stueck) as stueck,
sum(stat.umsatz) as umsatz,
sum(stat.umsatzek) as umsatzek,
sum(art.volume * stat.stueck / 100) as hl,
sum(stat2.stueck) as stueck2,
sum(art.volume * stat2.stueck / 100) as hl2,
param_bpg.name as bpg_name
from stat 
full outer join stat2 using (m_product_id, c_bpartner_id)
left join c_bpartner bp on(coalesce(stat.c_bpartner_id, stat2.c_bpartner_id) = bp.c_bpartner_id)
left join ad_user adm on(adm.ad_user_id = bp.salesrep_id)
left join bay_product_v art on(coalesce(stat.m_product_id, stat2.m_product_id) = art.m_product_id)
left join m_product p on (p.m_product_id = art.m_product_id)
left join c_bpartner_product bpp on(bpp.m_product_id = art.m_product_id and bpp.ismanufacturer = 'Y' and bpp.isactive = 'Y')
left join c_bpartner manu on (manu.c_bpartner_id = bpp.c_bpartner_id)
cross join per
cross join per2
cross join bay_company_v company
left join c_bp_group param_bpg on per.c_bp_group_id = param_bpg.c_bp_group_id
where manu.c_bpartner_id = per.manufacturer_id or per.manufacturer_ID is null or per.manufacturer_id = 0
group by 
manu.value,
manu.name,
art.cat_value,
art.cat_name,
p.classification,
art.value,
art.name_base,
art.name_tu,
art.isactive,
bp.value,
bp.name,
bp.name2,
adm.name,
param_bpg.name
having
  (
    -- filtert Zeilen ohne Hektoliter, damit auch Gläser, Werbematerial, etc.
    sum(art.volume * coalesce(stat.stueck,0) / 100) > 0
    or
    sum(art.volume * coalesce(stat2.stueck,0) / 100) > 0
  )
order by
manu.value,
art.cat_value,
p.classification,
art.value,
bp.value]]>
	</queryString>
