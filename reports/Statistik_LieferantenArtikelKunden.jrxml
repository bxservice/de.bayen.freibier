	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="613"/>
	<parameter name="C_BPartner_ID" class="java.lang.Integer">
		<parameterDescription><![CDATA[Lieferant, z.B. Rhodius (1006859)]]></parameterDescription>
	</parameter>
	<parameter name="months" class="java.math.BigDecimal">
		<defaultValueExpression><![CDATA[new BigDecimal(2)]]></defaultValueExpression>
	</parameter>
	<queryString language="SQL">
		<![CDATA[WITH query AS (
select
   $P{C_BPartner_ID} AS lief_id,
  $P{months}  as months
)
,
abfrage as (
SELECT
 p.value as p_value,
 p.name as p_name,
 kd.value as kd_value,
 kd.name as kd_name,
 trunc(sum(stat.stueck)) as stueck,
 lief.value as lief_value,
 lief.name as lief_name,
 query.months as query_months
FROM m_product p
cross join query
--JOIN c_bpartner_product bpp ON (bpp.m_product_id = p.m_product_id)
JOIN m_product_po ppo ON (ppo.m_product_id = p.m_product_id)
join c_bpartner lief ON (ppo.c_bpartner_id = lief.c_bpartner_id and ppo.isactive='Y' AND lief.c_bpartner_id=query.lief_id)
join m_product_category pcat on (pcat.m_product_category_id = p.m_product_category_id)
left join (
       select stat.* 
       from bay_umsatzstatistik stat
       cross join query
       join bay_statistikperiode sper on (stat.bay_statistikperiode_id = sper.bay_statistikperiode_id 
								and sper.statistiktyp = 'MD' and sper.startdate > now() - interval '1 months' * query.months)
       join c_bpartner kd on (kd.c_bpartner_id = stat.c_bpartner_id
                            and kd.isactive='Y' and kd.iscustomer='Y')
       ) stat on (stat.m_product_id = p.m_product_id)
left join c_bpartner kd on (kd.c_bpartner_id = stat.c_bpartner_id)
WHERE p.ad_client_id=1000000
  and p.isactive='Y'
  and not pcat.value in ('18')  -- Gläser
group by
 p.value,
 p.name,
 kd.value,
 kd.name,
 lief.value,
 lief.name,
 query_months
order by
  p.value,
  kd.value
)
select
 p_value,
 p_name,
 kd_value,
 kd_name,
 stueck,
 sum(stueck) over (partition by p_value) as stuecksumme,
 lief_value,
 lief_name,
 query_months
from abfrage
order by 
  p_value, 
  kd_value
]]>
	</queryString>
