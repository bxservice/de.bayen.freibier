<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Statistik Lieferanten-Artikel-Kunden" columnCount="2" pageWidth="595" pageHeight="842" columnWidth="270" columnSpacing="10" leftMargin="24" rightMargin="20" topMargin="20" bottomMargin="20" uuid="7389509f-40b7-40cd-ad1b-b4582441b98c">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Controlling"/>
	<property name="com.jaspersoft.studio.unit." value="pixel"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="380"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="613"/>
	<parameter name="C_BPartner_ID" class="java.lang.Integer">
		<parameterDescription><![CDATA[Lieferant, z.B. Rhodius (1006859)]]></parameterDescription>
	</parameter>
	<parameter name="months" class="java.math.BigDecimal">
		<defaultValueExpression><![CDATA[new BigDecimal(2)]]></defaultValueExpression>
	</parameter>
	<queryString language="SQL">
		<![CDATA[WITH query AS (
 select
  $P{C_BPartner_ID}::numeric AS lief_id,
  $P{months} AS months,
  (current_date - interval '1 month' * $P{months})::date AS von
)
,
artikel AS (
 SELECT DISTINCT p.m_product_id, p.value, p.name, p.isactive, lief.value AS lief_value, lief.name AS lief_name
 FROM m_product p
 cross join query
 JOIN m_product_po ppo ON (ppo.m_product_id = p.m_product_id AND ppo.isactive='Y')
 JOIN c_bpartner lief ON (lief.c_bpartner_id = ppo.c_bpartner_id AND lief.c_bpartner_id = query.lief_id)
 JOIN m_product_category pcat ON (pcat.m_product_category_id = p.m_product_category_id)
 WHERE p.ad_client_id=1000000
   AND pcat.value <> '18'  -- Gläser
)
,
umsatz AS (
 -- Kunde und Datum vom Lieferschein (bei Zentralregulierung steht auf der Rechnung der Regulierer)
 SELECT il.m_product_id, coalesce(o.c_bpartner_id, i.c_bpartner_id) AS c_bpartner_id, sum(il.qtyinvoiced) AS stueck
 FROM c_invoiceline il
 cross join query
 JOIN c_invoice i ON (i.c_invoice_id = il.c_invoice_id)
 LEFT JOIN c_orderline ol ON (ol.c_orderline_id = il.c_orderline_id)
 LEFT JOIN c_order o ON (o.c_order_id = ol.c_order_id)
 WHERE i.ad_client_id=1000000
   AND i.issotrx='Y'
   AND i.docstatus IN ('CO','CL')
   AND il.m_product_id IN (select m_product_id from artikel)
   AND coalesce(o.dateordered, i.dateinvoiced) >= query.von
 GROUP BY 1, 2
 HAVING sum(il.qtyinvoiced) <> 0  -- Lieferung und Rückgabe heben sich auf
)
,
abfrage AS (
 SELECT
  a.value AS p_value,
  a.name AS p_name,
  kd.value AS kd_value,
  kd.name AS kd_name,
  u.stueck,
  a.lief_value,
  a.lief_name
 FROM artikel a
 LEFT JOIN umsatz u ON (u.m_product_id = a.m_product_id)
 LEFT JOIN c_bpartner kd ON (kd.c_bpartner_id = u.c_bpartner_id)
 WHERE a.isactive='Y' OR u.stueck IS NOT NULL  -- inaktive Artikel nur, wenn sie noch verkauft wurden
)
select
 p_value,
 p_name,
 kd_value,
 kd_name,
 stueck,
 sum(stueck) over (partition by p_value) as stuecksumme,
 lief_value,
 lief_name,
 query.months as query_months,
 query.von::timestamp as query_von
from abfrage
cross join query
order by
  p_value,
  stueck desc nulls last,
  kd_value
]]>
	</queryString>
