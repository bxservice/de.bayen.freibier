<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Anrufliste_Artikelliste" columnCount="2" pageWidth="550" pageHeight="842" columnWidth="265" columnSpacing="20" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="29d5ab69-67b8-4a2d-a673-11724005d212">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Controlling.xml"/>
