	<template><![CDATA[$P{SUBREPORT_DIR}+"BayenStyles.jrtx"]]></template>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<parameterDescription><![CDATA[]]></parameterDescription>
		<defaultValueExpression><![CDATA["./"]]></defaultValueExpression>
	</parameter>
	<parameter name="C_BPartner_ID" class="java.lang.Integer">
		<parameterDescription><![CDATA[]]></parameterDescription>
		<defaultValueExpression><![CDATA[1011485]]></defaultValueExpression>
	</parameter>
	<parameter name="C_BP_Group_ID" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[null]]></defaultValueExpression>
	</parameter>
	<parameter name="Period" class="java.lang.String">
		<defaultValueExpression><![CDATA["gj2026"]]></defaultValueExpression>
	</parameter>
	<parameter name="sortierung" class="java.lang.String">
		<parameterDescription><![CDATA[leer oder A für alphabetisch nach Kunden]]></parameterDescription>
	</parameter>
	<parameter name="intern" class="java.lang.String">
		<defaultValueExpression><![CDATA["Y"]]></defaultValueExpression>
	</parameter>
	<queryString language="SQL">
		<![CDATA[with params as (
select
  $P{Period}::text periode1,
  null::text periode2,
  $P{C_BPartner_ID}::numeric c_bpartner_id,
  $P{C_BP_Group_ID}::numeric c_bp_group_id,
  $P{sortierung}::text sortierung,
  $P{intern}::text intern
),
bpartner_filter as (
select bp.c_bpartner_id
from c_bpartner bp
cross join params
where ad_client_id=1000000
  and (bp.c_bpartner_id=params.c_bpartner_id or params.c_bpartner_id is null or params.c_bpartner_id=0)
  and (bp.c_bp_group_id=params.c_bp_group_id or params.c_bp_group_id is null or params.c_bp_group_id=0)
)
,
per as(
select * 
from bay_statperiod_v per
cross join params
where per.value = periode1
),
per2 as(
select * 
from params
left join bay_statperiod_v per on (
  per.value = coalesce(periode2,
  	case when left (periode1,2)='st' 
  	     then 'st' || to_char(substring(periode1 from 3 for 2)::numeric -1,'FM00') || substring(periode1 from 5 for 2)
  	     when left (periode1,2)='gj' 
  	     then 'gj' || to_char(substring(periode1 from 3 for 4)::numeric -1,'FM0000')
  	     else null
  	     end
  ))
),
stat as (
select stat.*
from per
left join bay_umsatzstat_v stat using(bay_statistikperiode_id)
join m_product p using (m_product_id)
join bpartner_filter bp_f on (bp_f.c_bpartner_id=stat.c_bpartner_id)
where p.c_uom_id = stat.c_uom_id  -- nur Zeilen mit der Haupt-UOM zählen
  -- man könnte das auch umrechnen, addieren, und dann kürzen. Das kommt bisher praktisch aber aufs gleiche raus und würde wohl Performance kosten
) 
-- Debugging wg. Kosakowski und Knobelbecher mit Würfeln
--select stat.*, c_bpartner.value, c_bpartner.name from stat join c_bpartner using (c_bpartner_id) where m_product_id = (select m_product_id from m_product where m_product.value='90085')
,
stat2 as (
select stat2.* 
from per2
left join bay_umsatzstat_v stat2 using(bay_statistikperiode_id)
join m_product p using (m_product_id)
join bpartner_filter bp_f on (bp_f.c_bpartner_id=stat2.c_bpartner_id)
where p.c_uom_id = stat2.c_uom_id  -- nur Zeilen mit der Haupt-UOM zählen
  -- man könnte das auch umrechnen, addieren, und dann kürzen. Das kommt bisher praktisch aber aufs gleiche raus und würde wohl Performance kosten
)
select
per.value as per_value,
per.startdate,
per.enddate,
per.name as per_name,
per2.value as per2_value,
per2.name as per2_name,
bp.value as kd_nr,
bp.name as kd_name,
bp.name2 as kd_name2,
adm.name as adm,
art.cat_value as akat_nr,
art.cat_name as akat_name,
art.value as art_nr,
art.name_base as art_name,
art.name_tu as art_tu,
art.isactive as art_isactive,
stat.lieferungen,
stat.stueck,
stat.stueckgratis,
stat.umsatz,
stat.umsatzek,
art.volume * stat.stueck / 100 as hl,
stat2.stueck as stueck2,
art.volume * stat2.stueck / 100 as hl2,
company.org_name,
case when row_number() over(order by
    case when per.sortierung='A' then bp.name else '' end,
    bp.value, art.cat_value, art.value
  ) = 1 
  then company.logo else null end as logo
from stat 
full outer join stat2 using (m_product_id, c_bpartner_id)
left join c_bpartner bp on(coalesce(stat.c_bpartner_id, stat2.c_bpartner_id) = bp.c_bpartner_id)
left join ad_user adm on(adm.ad_user_id = bp.salesrep_id)
left join bay_product_v art on(coalesce(stat.m_product_id, stat2.m_product_id) = art.m_product_id)
cross join per
cross join per2
cross join bay_company_v company
order by
case when per.sortierung='A' then bp.name else '' end,
bp.value,
art.cat_value,
art.value]]>
	</queryString>
