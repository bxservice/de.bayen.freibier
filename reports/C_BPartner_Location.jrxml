	<parameter name="RECORD_ID" class="java.lang.Integer">
		<parameterDescription><![CDATA[Beispiel Schwarzes Pferd: 1009980]]></parameterDescription>
	</parameter>
	<queryString>
		<![CDATA[select 
bpl.name,
loc.address1, loc.address2, loc.postal, loc.city,
bpl.isshipto, bpl.isbillto
from c_bpartner_location bpl
join c_location loc on loc.c_location_id = bpl.c_location_id
where
bpl.isactive='Y'
and bpl.c_bpartner_location_id =  $P{RECORD_ID}]]>
	</queryString>
