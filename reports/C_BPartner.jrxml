	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<parameterDescription><![CDATA[]]></parameterDescription>
		<defaultValueExpression><![CDATA["./"]]></defaultValueExpression>
	</parameter>
	<parameter name="RECORD_ID" class="java.lang.Integer"/>
	<queryString>
		<![CDATA[with bploc as (
-- Ergibt die Haupt-Location (und damit z.B. die Absatzstättennummer) oben
select 
	bpl.c_bpartner_location_id, bpl.c_bpartner_id,
	bpl.c_salesregion_id,
	bpl.bay_deliveryday, bpl.bay_deliveryburden, bpl.bay_deliverydifficulty,
	loc.address1, loc.address2, loc.postal, loc.city
from c_bpartner_location bpl
join c_location loc on loc.c_location_id = bpl.c_location_id
and bpl.isactive='Y'
order by (bpl.isshipto) desc, (bpl.c_salesregion_id is null), (bpl.bay_route_id is null)
)
--
select
bp.c_bpartner_id,
bp.value as bp_value, 
bp.name as bp_name,
bp.name2 as bp_name2,
bp.logo_id,
bpl1.c_bpartner_location_id,
-- Absatzstätte
sr.value as sr_value, 
sr.name as sr_name,
-- Kunde/Aquise
case when bp.iscustomer='Y' then 'K' when bp.isprospect='Y' then 'A' else '-' end as kundenart,
-- GP-Gruppe
bpg."name" as bpgroup_name,
-- Betriebstyp / Saal/Terrasse/Biergarten
btyp.name as ngvbetriebstyp,
bp.betriebstypsaal,
bp.betriebstypbiergarten,
bp.betriebstypterrasse,
-- Außendienstler
ad.name as ad_name,
-- Besuchsfrequenz
bp.bay_contactfrequency,
--
-- Zahlungsweise
payr_d.name as paymentrule,
-- Zahlungsbedingung
pt.name as paymentterm,
-- Bankkonto/SEPA-Mandat
bank.*,
--
-- Liefertag
-- alleine liefern
-- Lieferschwierigkeit
bpl1.bay_deliveryday, bpl1.bay_deliveryburden, bpl1.bay_deliverydifficulty,
delb.name as deliveryburden,
deld.name as deliverydifficulty,
delt_d.name as deliveryday,
-- Lieferscheintext
bp.so_description,
--
-- Beschreibung/Kommentar
bp.description,
-- Liefergebiet
da."name" as da_name,
trim(leading ', ' from
(case when (select dd.bxs_isoptional from bay_deliveryday dd where dd.bay_deliveryarea_id = da.bay_deliveryarea_id and dd.isactive='Y' 
	and dd.weekday='1') is not distinct from 'N' then ', Montag' else '' end)
|| (case when (select dd.bxs_isoptional from bay_deliveryday dd where dd.bay_deliveryarea_id = da.bay_deliveryarea_id and dd.isactive='Y' 
	and dd.weekday='2') is not distinct from 'N' then ', Dienstag' else '' end)
|| (case when (select dd.bxs_isoptional from bay_deliveryday dd where dd.bay_deliveryarea_id = da.bay_deliveryarea_id and dd.isactive='Y' 
	and dd.weekday='3') is not distinct from 'N' then ', Mittwoch' else '' end)
|| (case when (select dd.bxs_isoptional from bay_deliveryday dd where dd.bay_deliveryarea_id = da.bay_deliveryarea_id and dd.isactive='Y' 
	and dd.weekday='4') is not distinct from 'N' then ', Donnerstag' else '' end)
|| (case when (select dd.bxs_isoptional from bay_deliveryday dd where dd.bay_deliveryarea_id = da.bay_deliveryarea_id and dd.isactive='Y' 
	and dd.weekday='5') is not distinct from 'N' then ', Freitag' else '' end)
|| (case when (select dd.bxs_isoptional from bay_deliveryday dd where dd.bay_deliveryarea_id = da.bay_deliveryarea_id and dd.isactive='Y' 
	and dd.weekday='6') is not distinct from 'N' then ', Samstag' else '' end)
|| (case when (select dd.bxs_isoptional from bay_deliveryday dd where dd.bay_deliveryarea_id = da.bay_deliveryarea_id and dd.isactive='Y' 
	and dd.weekday='7') is not distinct from 'N' then ', Sonntag' else '' end)
) as da_liefertage,
ak.ak_name,
(select ('{Montag,Dienstag,Mittwoch,Donnerstag,Freitag,Samstag}'::text[])[ak.bay_callday::integer]) as bay_callday,
ak.bay_calltime,
ak.ak_description
--
FROM C_BPartner bp
join lateral (
	select * from bploc where bploc.c_bpartner_id = bp.c_bpartner_id fetch first 1 row only
) as bpl1 on true
left join c_salesregion sr on sr.c_salesregion_id = bpl1.c_salesregion_id
join c_bp_group bpg on bpg.c_bp_group_id = bp.c_bp_group_id
left join ad_ref_list btyp on btyp.value=bp.ngvbetriebstyp and btyp.ad_reference_id = (select ad_reference_id from ad_reference where name='BAY_NGV_Betriebstyp')
left join ad_user ad on ad.ad_user_id=bp.salesrep_id
left join ad_ref_list payr on payr.value=bp.paymentrule and payr.ad_reference_id = (select ad_reference_id from ad_reference where name='_Payment Rule')
left join ad_ref_list_trl payr_d on payr.ad_ref_list_id = payr_d.ad_ref_list_id and payr_d.ad_language = 'de_DE'
left join c_paymentterm_trl pt on pt.c_paymentterm_id = bp.c_paymentterm_id
left join lateral (
	select ba.a_name as ktoinhaber, ba.iban, ba.mndtid, ba.datedoc::date, ba.sepasddscheme
	from c_bp_bankaccount ba 
	where ba.c_bpartner_id = bp.c_bpartner_id and ba.bpbankacctuse ='D' and ba.isactive = 'Y' 
	order by ba.datedoc desc fetch first 1 row only 
) as bank on true
left join ad_ref_list delb on delb.value=bpl1.bay_deliveryburden and delb.ad_reference_id = (select ad_reference_id from ad_reference where name='BAY Liefererschwernis')
left join ad_ref_list deld on deld.value=bpl1.bay_deliverydifficulty and deld.ad_reference_id = (select ad_reference_id from ad_reference where name='BAY Schwierigkeit Abladen')
left join ad_ref_list delt on delt.value=bpl1.bay_deliveryday and delt.ad_reference_id = (select ad_reference_id from ad_reference where name='Weekdays')
left join ad_ref_list_trl delt_d on delt_d.ad_ref_list_id = delt.ad_ref_list_id and delt_d.ad_language = 'de_DE'
left join bay_delivery_bplocationarea(bpl1.c_bpartner_location_id) bpla on true
left join bay_deliveryarea da on da.bay_deliveryarea_id = bpla.bay_deliveryarea_id
left join lateral (
  -- Anrufkarte
  select s_u.name as ak_name, s_ci.bay_callday, s_ci.bay_calltime::time, s_ci.description as ak_description
  from ad_user s_u
  join r_contactinterest s_ci on s_ci.ad_User_id = s_u.ad_user_id
  where s_u.c_bpartner_id=bp.c_bpartner_id and s_u.isactive='Y' and s_ci.isactive ='Y'
  order by s_u.ad_user_id fetch first row only
) as ak on true
where bp.C_BPartner_ID = $P{RECORD_ID}
union select null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null
where $P{RECORD_ID} is null
]]>
	</queryString>
