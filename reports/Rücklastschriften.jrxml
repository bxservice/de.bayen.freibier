<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Rücklastschriften" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="c6b51a16-01b1-4e58-aa19-8232164910f7">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Controlling"/>
	<queryString language="SQL">
		<![CDATA[select
-- DISTINCT nimmt von mehreren Zahlungen auf diese Rechnung genau eine heraus.
-- Welche genau, entscheidet das order by unten.
distinct on (i.documentno)
--
bp.value as bp_value, 
bp.name as bp_name,
i.documentno,
i.dateinvoiced,
oi.duedate,
p.datetrx as retdat,
i.grandtotal,
oi.openamt,
ad.value as ad_value,
p.documentno as retno,
case when p.documentno is null 
     then psl.name
     else p.description
end as retdesc
--
FROM
rv_openitem oi
join c_bpartner bp using (c_bpartner_id)
join c_invoice i using (c_invoice_id)
left join ad_user ad on (bp.salesrep_id = ad.ad_user_id)
left join (
  select aline.c_allocationline_id, aline.c_invoice_id, p.c_payment_id
  from c_allocationline aline
  join c_allocationhdr ahdr on (ahdr.c_allocationhdr_id = aline.c_allocationhdr_id and ahdr.docstatus NOT IN ('VO', 'RE'))
  join c_payment p on(p.c_payment_id = aline.c_payment_id and p.DocStatus NOT IN ('VO', 'RE'))
) aline using (c_invoice_id)
left join c_payment p on(p.c_payment_id = aline.c_payment_id)
join (
  select psl.*, ps.*
  from C_PaySelectionLine psl
  join c_payselection ps using (c_payselection_id)
  join C_PaySelectionCheck psc using (c_payselectioncheck_id)
  left join c_payment pmt using (c_payment_id)
  WHERE psl.IsActive = 'Y'
    AND (pmt.DocStatus IS NULL OR pmt.DocStatus NOT IN ('VO', 'RE'))
) psl on (oi.c_invoice_id = psl.c_invoice_id)
where oi.ad_client_id=1000000
 and oi.issotrx='Y'  -- Verkaufstransaktion
 and oi.documentno like 'R%'
 and oi.ispaid='N'
 and oi.docstatus='CO'
-- and oi.documentno =  'R77462'
order by
  -- Das ist die Hauptsortierung. Da ich ein DISTINCT benutze (um aus evtl. mehreren Zahlungen an einer Rechnung
  -- die richtige Retoure herauszufinden, ist das etwas kompliziert.
  -- Da die eigentliche Sortierung hier, die ich in der Liste haben möchte, einzigartig ist (unique), kann ich
  -- sie in das DISCTINCT mit hineinschreiben, ohne das etwas verloren geht und kann dann hier danach sortieren.
  --
  -- In diesem Fall steht hier nix, weil ich nach Rechnungsnummern sortieren möchte, die auch mein
  -- DISTINCT-Kennzeichen sind.
  --
  -- das ist der DISTINCT Parameter von oben, den ich haben möchte
  i.documentno desc,
  -- innerhalb des DISTINCT möchte ich Daten aus dem Datensatz ziehen, der die aktuellste negative Zahlung beschreibt
  -- (also die jeweils letzte Retoure, die dieser Rechnung zugeordnet wurde)
  p.payamt>0,
  p.documentno desc,
  bp.value, i.documentno
]]>
	</queryString>
