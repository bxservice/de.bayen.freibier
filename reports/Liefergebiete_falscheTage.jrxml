	<parameter name="CalendarYear" class="java.lang.String">
		<parameterDescription><![CDATA[Kalenderjahr für die Analyse oder null für die Übersicht]]></parameterDescription>
	</parameter>
	<parameter name="cwfrom" class="java.math.BigDecimal">
		<parameterDescription><![CDATA[Kalenderwoche von (oder null für die Übersicht)]]></parameterDescription>
	</parameter>
	<parameter name="cwto" class="java.math.BigDecimal">
		<parameterDescription><![CDATA[Kalenderwoche bis (oder null für die Übersicht)]]></parameterDescription>
	</parameter>
	<queryString language="SQL">
		<![CDATA[with params as(
select
$P{CalendarYear}::integer as jahr,
$P{cwfrom}::integer as kwstart,
$P{cwto}::integer as kwend
)
select
params.jahr, params.kwstart, params.kwend,
sr.value as sr_value, sr.name as sr_name,
da.value as da_value, da.name as da_name,
bp.value as bp_value, bp.name as bp_name,
o.documentno, o.dateordered,
geliefertertag, liefertagetext
from params
cross join bay_delivery_orderlist(jahr,kwstart,kwend) ol
--from bay_delivery_orderlist(2022,52,52) ol
join c_order o using (c_order_id)
join c_bpartner bp using (c_bpartner_id)
left join ad_user sr on bp.salesrep_id = sr.ad_user_id 
join bay_deliveryarea da using (bay_deliveryarea_id)
where tourcheck = '-'
order by sr.value, da.value, bp.value, o.dateordered, o.documentno 
;
]]>
	</queryString>
