	<parameter name="RECORD_ID" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[1003413]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
p.value AS p_no,
--p.name AS p_name,
CASE WHEN p.bay_tradingunit_id IS NULL THEN p.name ELSE p.description END AS basisname,
--p.name,
--p.description,
tu.name AS gebindename,
tu.einheit AS flaschengroesse,
p.upc AS ean,
pr.level_min,
ve.value AS ve_value,
ve.name AS ve_name,
po.vendorproductno,
po.vendorproductname,
pi.description,
pi.bay_weinfarbe, pi.bay_weinfarbe2,
c.name as land,
pi.bay_gebiet, 
bay_geschmack,
bay_aroma,
bay_alkoholgehalt,
pi.ad_image_id, i.binarydata as pi_image
FROM m_product p
LEFT JOIN bay_tradingunit tu ON (p.bay_tradingunit_id = tu.bay_tradingunit_id)
left JOIN (SELECT DISTINCT ON (m_product_id) * FROM m_replenish)
     AS pr ON pr.m_product_id = p.m_product_id
LEFT JOIN (SELECT DISTINCT ON (m_product_id) * FROM m_product_po po WHERE po.isactive = 'Y' AND iscurrentvendor = 'Y')
     AS po ON po.m_product_id = p.m_product_id
LEFT JOIN c_bpartner ve ON ve.c_bpartner_id = po.c_bpartner_id
LEFT JOIN (SELECT DISTINCT ON (m_product_id) * FROM bay_productinfo pi WHERE pi.isactive = 'Y')
     AS pi ON pi.m_product_id = p.m_product_id
left join ad_image i on i.ad_image_id = pi.ad_image_id 
left join c_country_trl c on c.c_country_id = pi.c_country_id and c.ad_language = 'de_DE'
WHERE
p.ad_client_id = 1000000 AND p.isactive = 'Y'
AND (SELECT pc.value FROM m_product_category pc WHERE pc.m_product_category_id = p.m_product_category_id) IN ('21')
--and pi.m_product_id is not null
and p.m_product_id =  $P{RECORD_ID}]]>
	</queryString>
