	<queryString>
		<![CDATA[-- Kundensortiment
select
bp.value as bp_value,
bp.name as bp_name,
ol.qtyordered,
p.value as p_value,
p.name as p_name,
ol.description,
ol.line 
from c_order o
join c_doctype dt on dt.c_doctype_id = o.c_doctypetarget_id and dt.name='Kundensortiment'
join c_bpartner bp on bp.c_bpartner_id = o.c_bpartner_id
join c_orderline ol on ol.c_order_id = o.c_order_id and ol.bay_masterorderline_id is null and ol.isActive='Y'
join m_product p on p.m_product_id = ol.m_product_id
where bp.isActive='Y' and bp.c_bpartner_id = $P{RECORD_ID} 
order by ol.qtyordered, ol.line
]]>
	</queryString>
