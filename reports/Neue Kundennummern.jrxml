<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Neue Kundennummern" columnCount="3" pageWidth="595" pageHeight="842" columnWidth="185" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="5c42d32f-9d74-4f98-a41d-fde494a1d4d5">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Controlling"/>
	<queryString language="SQL">
		<![CDATA[(
with buchstaben as (
select generate_series(1,28) as code
)
, sortalphabet as (
select 
code, 
case when code <= 19 then chr(ascii('A')-1+code)
     when code = 20 then 'SCH'
     when code = 21 then 'ST'
     when code >= 22 then chr(ascii('A')-1+code-2) 
     end as zeichen
from buchstaben
)
,
allewerte as (
select 
sa.*, 
(st1.num*10000+st2.num*1000+code*100+st45.num)::text as value
from sortalphabet sa
cross join (select generate_series(1,99) num) as st45
cross join (values (0),(3),(6)) as st2(num)
cross join (values (6),(7))as st1(num)
)
select
'6/7 Privatkunden' as gruppe, zeichen,code,
min(aw.value)
from allewerte aw
left join c_bpartner bp on aw.value = bp.value
where bp.value is null
group by zeichen, code
order by gruppe, zeichen, code
)
--
union
--
(
with buchstaben as (
select generate_series(1,28) as code
)
, sortalphabet as (
select 
code, 
case when code <= 19 then chr(ascii('A')-1+code)
     when code = 20 then 'SCH'
     when code = 21 then 'ST'
     when code >= 22 then chr(ascii('A')-1+code-2)
     end as zeichen
from buchstaben
)
,
allewerte as (
select 
sa.*, 
(st1.num*10000+st2.num*1000+code*100+st45.num)::text as value
from sortalphabet sa
cross join (select generate_series(1,99) num) as st45
cross join (values (0),(3),(6)) as st2(num)
cross join (values (5))as st1(num)
)
select
'5 Gewerbe' as gruppe,
zeichen,code,
min(aw.value)
from allewerte aw
left join c_bpartner bp on aw.value = bp.value
where bp.value is null
group by zeichen, code
order by gruppe, zeichen, code
)
--
union
--
(
with buchstaben as (
select generate_series(1,28) as code
)
, sortalphabet as (
select 
code, 
case when code <= 19 then chr(ascii('A')-1+code)
     when code = 20 then 'SCH'
     when code = 21 then 'ST'
     when code >= 22 then chr(ascii('A')-1+code-2)
     end as zeichen
from buchstaben
)
,
allewerte as (
select 
sa.*, 
(st1.num*10000+st2.num*1000+code*100+st45.num)::text as value
from sortalphabet sa
cross join (select generate_series(1,99) num) as st45
cross join (values (0),(3),(6)) as st2(num)
cross join (values (4))as st1(num)
)
select
'4 Grossabnehmer' as gruppe,
zeichen,code,
min(aw.value)
from allewerte aw
left join c_bpartner bp on aw.value = bp.value
where bp.value is null
group by zeichen, code
order by gruppe, zeichen, code
)
order by gruppe, zeichen, code
]]>
	</queryString>
