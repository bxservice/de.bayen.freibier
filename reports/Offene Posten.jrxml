	</field>
	<variable name="openamt1" class="java.math.BigDecimal" resetType="Group" resetGroup="bpvalue" calculation="Sum">
		<variableExpression><![CDATA[$F{openamt}]]></variableExpression>
	</variable>
	<variable name="openamt2" class="java.math.BigDecimal" resetType="Group" resetGroup="adname" calculation="Sum">
