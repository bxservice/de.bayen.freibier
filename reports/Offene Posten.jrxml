		<variableExpression><![CDATA[$F{openamt}]]></variableExpression>
	</variable>
	<group name="adname" isStartNewPage="true">
		<groupExpression><![CDATA[$F{adname}]]></groupExpression>
		<groupFooter>
			<band height="15">
				<property name="com.jaspersoft.studio.unit.height" value="px"/>
				<textField pattern="#,##0.00 ¤;-#,##0.00 ¤">
					<reportElement style="Narrow Lists Header" x="190" y="0" width="80" height="15" uuid="f1379c6d-09f5-4176-9bbf-37ea31920a5d">
						<property name="com.jaspersoft.studio.unit.height" value="px"/>
