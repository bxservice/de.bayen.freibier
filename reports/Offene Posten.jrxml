	<template><![CDATA[$P{SUBREPORT_DIR}+"BayenStyles.jrtx"]]></template>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<parameterDescription><![CDATA[]]></parameterDescription>
		<defaultValueExpression><![CDATA["./"]]></defaultValueExpression>
	</parameter>
	<parameter name="C_BPartner_ID" class="java.lang.Integer">
		<parameterDescription><![CDATA[Beispiel: 1002394 ist Wolff/Jazzkeller]]></parameterDescription>
		<defaultValueExpression><![CDATA[null]]></defaultValueExpression>
	</parameter>
	<parameter name="AD_Client_ID" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[1000000]]></defaultValueExpression>
	</parameter>
	<parameter name="SalesRep_ID" class="java.lang.Integer">
		<parameterDescription><![CDATA[Beispiel: 1001980 is Wintersig, 1001982 Di Marino, 1001976 ist Thomas Bayen]]></parameterDescription>
		<defaultValueExpression><![CDATA[null]]></defaultValueExpression>
	</parameter>
	<parameter name="DateReport" class="java.util.Date">
		<defaultValueExpression><![CDATA[null]]></defaultValueExpression>
	</parameter>
	<queryString language="SQL">
		<![CDATA[with param as (
select
  $P{AD_Client_ID} as ad_client_id,
  coalesce(
    $P{DateReport}
  ,now())::date as qdate,
  --date '2018-11-09' as qdate,
   case when $P{C_BPartner_ID} = 0 then null else $P{C_BPartner_ID} end as c_bpartner_id,
  --(select c_bpartner_id from c_bpartner where value = '35784') as c_bpartner_id,  -- Wolff/Jazzkeller
  --(select c_bpartner_id from c_bpartner where value = '12503') as c_bpartner_id,  -- Brockers, Effertzhof
  --(select c_bpartner_id from c_bpartner where value = '15798') as c_bpartner_id,   -- Enger, Mikado
  case when $P{SalesRep_ID} = 0 then null else $P{SalesRep_ID} end as salesrep_id,
  --(select ad_user_id from ad_user where value = 'mwinters') as salesrep_id,
  null::numeric(10,2) as minamt
  --10000::numeric(10,2) as minamt
), 
openitem_by_date as (
  -- view RV_OpenItem so angepasst, das es datumsabhängig arbeitet
 SELECT i.ad_org_id,
    i.ad_client_id,
    i.documentno,
    i.c_invoice_id,
    i.c_order_id,
    i.c_bpartner_id,
    i.issotrx,
    i.dateinvoiced,
    i.dateacct,
    p.netdays,
    paymenttermduedate(i.c_paymentterm_id, i.dateinvoiced::timestamp with time zone) AS duedate,
    paymenttermduedays(i.c_paymentterm_id, i.dateinvoiced::timestamp with time zone, getdate()) AS daysdue,
    adddays(i.dateinvoiced::timestamp with time zone, p.discountdays) AS discountdate,
    currencyround(i.grandtotal * p.discount / 100::numeric, i.c_currency_id, 'N'::character varying) AS discountamt,
    i.grandtotal,
    invoicepaidtodate(i.c_invoice_id, i.c_currency_id, 1::numeric, param.qdate) AS paidamt,
    invoiceopentodate(i.c_invoice_id, 0::numeric, param.qdate) AS openamt,
    i.c_currency_id,
    i.c_conversiontype_id,
    i.c_paymentterm_id,
    i.ispayschedulevalid,
    NULL::numeric AS c_invoicepayschedule_id,
    i.invoicecollectiontype,
    i.c_campaign_id,
    i.c_project_id,
    i.c_activity_id,
    i.c_invoice_ad_orgtrx_id AS ad_orgtrx_id,
    i.ad_user_id,
    i.c_bpartner_location_id,
    i.c_charge_id,
    i.c_doctype_id,
    i.c_doctypetarget_id,
    i.c_dunninglevel_id,
    i.chargeamt,
    i.c_payment_id,
    i.created,
    i.createdby,
    i.dateordered,
    i.dateprinted,
    i.description,
    i.docaction,
    i.docstatus,
    i.dunninggrace,
    i.generateto,
    i.isactive,
    i.isapproved,
    i.isdiscountprinted,
    i.isindispute,
    i.ispaid,
    i.isprinted,
    i.c_invoice_isselfservice AS isselfservice,
    i.istaxincluded,
    i.istransferred,
    i.m_pricelist_id,
    i.m_rma_id,
    i.paymentrule,
    i.poreference,
    i.posted,
    i.processedon,
    i.processing,
    i.ref_invoice_id,
    i.reversal_id,
    i.salesrep_id,
    i.sendemail,
    i.totallines,
    i.updated,
    i.updatedby,
    i.user1_id,
    i.user2_id
   FROM rv_c_invoice i
     JOIN c_paymentterm p ON i.c_paymentterm_id = p.c_paymentterm_id
     join c_bpartner bp on i.c_bpartner_id = bp.c_bpartner_id
     CROSS JOIN param
  WHERE invoiceopentodate(i.c_invoice_id, 0::numeric, param.qdate) <> 0::numeric AND i.ispayschedulevalid <> 'Y'::bpchar AND (i.docstatus = ANY (ARRAY['CO'::bpchar, 'CL'::bpchar]))
        and (param.c_bpartner_id is null or i.c_bpartner_id = param.c_bpartner_id)
        and (param.salesrep_id is null or param.salesrep_id = bp.salesrep_id)
UNION
 SELECT i.ad_org_id,
    i.ad_client_id,
    i.documentno,
    i.c_invoice_id,
    i.c_order_id,
    i.c_bpartner_id,
    i.issotrx,
    i.dateinvoiced,
    i.dateacct,
    daysbetween(ips.duedate::timestamp with time zone, i.dateinvoiced::timestamp with time zone) AS netdays,
    ips.duedate,
    daysbetween(getdate(), ips.duedate::timestamp with time zone) AS daysdue,
    ips.discountdate,
    ips.discountamt,
    ips.dueamt AS grandtotal,
    invoicepaidtodate(i.c_invoice_id, i.c_currency_id, 1::numeric, param.qdate) AS paidamt,
    invoiceopentodate(i.c_invoice_id, ips.c_invoicepayschedule_id, param.qdate) AS openamt,
    i.c_currency_id,
    i.c_conversiontype_id,
    i.c_paymentterm_id,
    i.ispayschedulevalid,
    ips.c_invoicepayschedule_id,
    i.invoicecollectiontype,
    i.c_campaign_id,
    i.c_project_id,
    i.c_activity_id,
    i.c_invoice_ad_orgtrx_id AS ad_orgtrx_id,
    i.ad_user_id,
    i.c_bpartner_location_id,
    i.c_charge_id,
    i.c_doctype_id,
    i.c_doctypetarget_id,
    i.c_dunninglevel_id,
    i.chargeamt,
    i.c_payment_id,
    i.created,
    i.createdby,
    i.dateordered,
    i.dateprinted,
    i.description,
    i.docaction,
    i.docstatus,
    i.dunninggrace,
    i.generateto,
    i.isactive,
    i.isapproved,
    i.isdiscountprinted,
    i.isindispute,
    i.ispaid,
    i.isprinted,
    i.c_invoice_isselfservice AS isselfservice,
    i.istaxincluded,
    i.istransferred,
    i.m_pricelist_id,
    i.m_rma_id,
    i.paymentrule,
    i.poreference,
    i.posted,
    i.processedon,
    i.processing,
    i.ref_invoice_id,
    i.reversal_id,
    i.salesrep_id,
    i.sendemail,
    i.totallines,
    i.updated,
    i.updatedby,
    i.user1_id,
    i.user2_id
   FROM rv_c_invoice i
     JOIN c_invoicepayschedule ips ON i.c_invoice_id = ips.c_invoice_id
     join c_bpartner bp on i.c_bpartner_id = bp.c_bpartner_id
     CROSS JOIN param
  WHERE invoiceopentodate(i.c_invoice_id, ips.c_invoicepayschedule_id, param.qdate) <> 0::numeric AND i.ispayschedulevalid = 'Y'::bpchar AND (i.docstatus = ANY (ARRAY['CO'::bpchar, 'CL'::bpchar])) AND ips.isvalid = 'Y'::bpchar
        and (param.c_bpartner_id is null or i.c_bpartner_id = param.c_bpartner_id)
        and (param.salesrep_id is null or param.salesrep_id = bp.salesrep_id)
),
wkr as(
select
  c.value,
  c."name",
  c.description,
  c.c_bpartner_id,
  c.datedoc::date,
  c.amount,
  c.payamt,
  c.bay_paymentfrequency,
  case when datefrom > pa.qdate
    then amount
    else case c.bay_paymentfrequency 
           when 'W' then greatest(c.amount - (1+floor(greatest(extract(days from pa.qdate-c.datefrom)-1,0)/7))*c.payamt, 0)
           when 'M' then greatest(c.amount - (1+extract(year from age(pa.qdate, c.datefrom+(interval '1 day')))*12+extract(month from age(pa.qdate, c.datefrom+(interval '1 day'))))*c.payamt, 0)
           else 0
         end
  end::numeric(10,2) as actualamt
from bay_contract c
left join c_bpartner bp using (c_bpartner_id)
left join c_paymentterm pt using (c_paymentterm_id)
cross join param pa
where c.ad_client_id=pa.ad_client_id
  and c.bay_contracttype='WKR' and c.isActive='Y'
  and (pa.c_bpartner_id is null or c.c_bpartner_id = pa.c_bpartner_id)
  and (pa.salesrep_id is null or pa.salesrep_id = bp.salesrep_id)
),
oilist as (
select
  bp.c_bpartner_id,
  bp.value as bpvalue,
  bp.name as bpname,
  bp.name2 as bpname2,
  bp.description as bpdescription,
  -- -TB-
  (select bpba.sepasddscheme from c_bp_bankaccount bpba where bpba.c_bpartner_id = bp.c_bpartner_id and bpba.isactive = 'Y' and bpba.bpbankacctuse in ('B','D') limit 1) as sepascheme,
  (select pt.name from c_paymentterm pt where pt.c_paymentterm_id = bp.c_paymentterm_id) as paymentterm,
  sum(op.openamt) over (partition by bp.value) as bpsumopenamt,
  sum(case when op.duedate <= pa.qdate then op.openamt else 0 end) over (partition by bp.value) as bpsumdueamt,
  sum(case when op.gracedate <= pa.qdate then op.openamt else 0 end) over (partition by bp.value) as bpsumgraceamt,
  op.oitype,
  op.documentno,
  op.oidate::date,
  op.duedate::date,
  op.gracedate::date,
  op.grandtotal,
  op.openamt,
  op.oidescription,
  ad.value as advalue,
  ad.name as adname,
  case
    when op.gracedate<=pa.qdate then 'M'  -- Mahnen
    when op.duedate<=pa.qdate then 'F'  -- Fällig
    else 'R' -- Rechnung
  end as oistatus
from (
select
  'R' as oitype,
  oi.c_bpartner_id,
  oi.documentno,
  oi.dateinvoiced as oidate,
  oi.duedate,
  oi.duedate + (coalesce(pt.gracedays,0) * interval '1 day') as gracedate,
  oi.grandtotal * (case when oi.issotrx='N' then -1 else 1 end) as grandtotal,
  oi.openamt * (case when oi.issotrx='N' then -1 else 1 end) as openamt,
  oi.description as oidescription
from openitem_by_date oi
left join c_paymentterm pt on (oi.c_paymentterm_id = pt.c_paymentterm_id)
cross join param pa
WHERE oi.ad_client_id = pa.ad_client_id 
UNION
SELECT 
   'Z' as oitype,
   p.c_bpartner_id,
   p.documentno,
   p.datetrx as oidate,
   p.datetrx as duedate,
   p.datetrx as gracedate,
   -p.availableamt * (case when p.isreceipt='N' then -1 else 1 end) as grandtotal,
   -p.availableamt * (case when p.isreceipt='N' then -1 else 1 end) as openamt,
   p.description as oidescription
FROM rv_payment p
cross join param pa
WHERE p.availableamt!=0
AND p.ad_client_id = pa.ad_client_id
and p.datetrx <= pa.qdate
and (pa.c_bpartner_id is null or p.c_bpartner_id = pa.c_bpartner_id)
) as op
left join c_bpartner bp using (c_bpartner_id)
left join ad_user ad on (bp.salesrep_id = ad.ad_user_id)
cross join param pa
where bp.iscustomer='Y'
and (pa.salesrep_id is null or ad.ad_user_id = pa.salesrep_id)
and (pa.c_bpartner_id is null or bp.c_bpartner_id = pa.c_bpartner_id)
ORDER BY ad.value, bp.value, oidate
)
select
  oilist.*,
  (select sum(actualamt) from wkr where wkr.c_bpartner_id=oilist.c_bpartner_id) as kreditrahmen,
  case when (select sum(actualamt) from wkr where wkr.c_bpartner_id=oilist.c_bpartner_id) >= oilist.bpsumopenamt then 'Y'
       when oilist.bpsumgraceamt <= 0 then 'Y'
       else 'N'
  end as kreditrahmeneingehalten
from oilist
cross join param pa
where (pa.minamt is null or oilist.bpsumopenamt >= pa.minamt)]]>
	</queryString>
	<field name="c_bpartner_id" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.name" value="c_bpartner_id"/>
		<property name="com.jaspersoft.studio.field.label" value="c_bpartner_id"/>
