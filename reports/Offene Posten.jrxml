	<group name="bpvalue">
		<groupExpression><![CDATA[$F{bpvalue}]]></groupExpression>
		<groupHeader>
			<band height="110">
				<property name="com.jaspersoft.studio.unit.height" value="px"/>
				<rectangle>
					<reportElement key="" style="gemerkert" x="0" y="0" width="509" height="35" uuid="7984d470-1089-4598-a4ff-c87c3cd0b42b">
						<printWhenExpression><![CDATA["N".equals($F{kreditrahmeneingehalten})]]></printWhenExpression>
					</reportElement>
